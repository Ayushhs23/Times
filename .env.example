# ============================================================
#   Times — AI-powered news intelligence platform — environment vars
# ============================================================

# --- News source (REQUIRED) ---------------------------------
# Get a free API key at https://newsdata.io/register
NEWSDATA_API_KEY=

# --- AI provider (OPTIONAL — fallback NLP runs without it) --
# Get a key at https://console.anthropic.com (used for summary,
# sentiment, and key-insight extraction). If unset, the app
# falls back to a built-in lexicon + extractive summarizer.
ANTHROPIC_API_KEY=

# --- Database (OPTIONAL) ------------------------------------
# Default: SQLite file at ./data/news.db (zero-setup, local).
# For production / Vercel, set DATABASE_URL to a Postgres
# connection string (Neon, Supabase, Vercel Postgres, etc.):
#   DATABASE_URL=postgres://user:pass@host/db?sslmode=require
DATABASE_URL=

# --- Pipeline tuning (OPTIONAL) -----------------------------
# Number of articles to fetch per `npm run fetch-news` run.
FETCH_TARGET=120
# NewsData.io query (topics, language, country). Comma-separated
# values where supported. See https://newsdata.io/documentation
FETCH_QUERY=
FETCH_LANGUAGE=en
FETCH_CATEGORY=
